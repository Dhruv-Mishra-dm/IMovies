# Dependencies (re-created by `npm install`)
node_modules/

# Environment files hold secrets — NEVER commit them.
# Only the *.env.example templates are committed.
.env
.env.*
!.env.example

# Build output
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*

# Credentials and keys — never commit
*.pem
*.key
*.p12
*.pfx

# Temporary files and local database data
tmp/
*.tmp
data/db/

# Test reports
test-results/
playwright-report/

# Editor / OS clutter
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
