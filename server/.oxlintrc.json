{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "import", "node"],
  "env": {
    "node": true
  },
  "rules": {
    "no-console": "warn"
  },
  "overrides": [
    {
      "files": ["src/config/env.js", "scripts/**"],
      "rules": { "no-console": "off" }
    }
  ]
}
