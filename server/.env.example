# Copy this file to `.env` (same folder) and adjust if needed.
# `.env` is ignored by Git; this example file contains NO real secrets.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=5000

# Local Docker MongoDB (see docker-compose.yml). Only reachable from this PC.
# replicaSet=rs0 is required for transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/imovies?replicaSet=rs0

# Database used by `npm test` — kept separate so tests never touch your dev data.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/imovies_test?replicaSet=rs0

# The React app's address (no trailing slash). Only this origin is allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# REQUIRED: secret used to sign login tokens (at least 32 characters). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the real value and never reuse it between environments.
JWT_ACCESS_SECRET=replace-with-a-long-random-value-from-the-command-above

# Optional security settings (defaults shown):
# BCRYPT_COST=12          password hashing work factor (production requires >= 12)
# COOKIE_SECURE=false     true = cookies only over HTTPS (default true when NODE_ENV=production)
# TRUST_PROXY=0           number of reverse proxies in front of the API (for correct client IPs)
# RATE_LIMIT_ENABLED=true

# Optional logging settings.
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent  (default: info; tests: silent)
# LOG_PRETTY: true = human-readable colour logs (default in development), false = JSON lines
# LOG_LEVEL=info
# LOG_PRETTY=true
