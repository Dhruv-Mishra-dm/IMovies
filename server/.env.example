# Copy this file to `.env` (same folder) and adjust if needed.
# `.env` is ignored by Git; this example file contains NO real secrets.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=5000

# Local Docker MongoDB (see docker-compose.yml). Only reachable from this PC.
# replicaSet=rs0 is required for transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/imovies?replicaSet=rs0

# Database used by `npm test` — kept separate so tests never touch your dev data.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/imovies_test?replicaSet=rs0

# The React app's address (no trailing slash). Only this origin is allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# Optional logging settings.
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent  (default: info; tests: silent)
# LOG_PRETTY: true = human-readable colour logs (default in development), false = JSON lines
# LOG_LEVEL=info
# LOG_PRETTY=true
